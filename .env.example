# NVIDIA NIM API Credentials
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
MODEL_FAST=meta/llama-3.2-11b-vision-instruct
MODEL_CODE=meta/llama-3.2-11b-vision-instruct

# Services Configuration
BACKEND_PORT=8000
TARGET_APP_HOST=target-app
TARGET_APP_PORT=8001
TARGET_APP_URL=http://target-app:8001

# Local development overrides (when running natively outside Docker)
LOCAL_TARGET_APP_URL=http://localhost:8001
